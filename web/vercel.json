{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/", "dest": "/index.html" }
  ],
  "functions": {
    "api/proxy.py": { "maxDuration": 60 },
    "api/extract.py": { "maxDuration": 30 },
    "api/search.py": { "maxDuration": 30 }
  }
}
